# Copy this to .env and fill in your actual values
FLASK_ENV=development
FLASK_DEBUG=true

# Neon Postgres connection string, copied from the Neon dashboard.
# Both "postgres://" and "postgresql://" forms are accepted; config.py rewrites
# them to the psycopg 3 driver and adds sslmode=require if it is missing.
# Leave this unset to fall back to the local SQLite file (demo use only).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Flask session signing key. Use a long random value, never the placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

OPENAI_API_KEY=your_openai_api_key_here

# Comma separated list of origins allowed to call this app cross-origin.
# Leave empty for a normal single-origin deployment.
CORS_ORIGINS=

# Set to true for one boot to create admin@diu-wise.ai, then unset it.
# If SEED_ADMIN_PASSWORD is empty a random password is generated and written to
# the application log once. There is no built in default password any more.
SEED_ADMIN=false
SEED_ADMIN_PASSWORD=

# Brevo, used for password reset email. Sent over Brevo's HTTP API rather
# than their SMTP relay, because Render's free instances block outbound
# traffic to SMTP ports 25, 465 and 587, which makes SMTP sends hang.
# Create the key in the Brevo dashboard under Settings, SMTP & API, API Keys.
# This is an API key, not the SMTP key. MAIL_DEFAULT_SENDER must be a sender
# address verified in Brevo. Leave the key empty to suppress sending (the app
# logs a warning instead of erroring).
BREVO_API_KEY=your_brevo_api_key_here
MAIL_DEFAULT_SENDER=team@example.com
# Seconds to wait on the Brevo API before giving up.
BREVO_API_TIMEOUT=10

# Google OAuth 2.0 sign-in. Create an OAuth client in Google Cloud Console
# (APIs & Services, Credentials, OAuth client ID, Web application) and add
# the callback as an authorized redirect URI:
#   local:  http://127.0.0.1:5000/auth/google/callback
#   render: https://YOUR-APP.onrender.com/auth/google/callback
# Leave both empty to disable the Google button cleanly.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Rate limits, in Flask-Limiter syntax.
RATELIMIT_LOGIN=10 per minute
RATELIMIT_CHAT=20 per minute
RATELIMIT_PASSWORD_RESET=5 per hour
# In-process memory is fine for a single worker. Point this at Redis if the app
# is ever run with more than one process.
RATELIMIT_STORAGE_URI=memory://
