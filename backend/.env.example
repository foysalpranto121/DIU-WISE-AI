# Copy this to .env and fill in your actual values
FLASK_ENV=development
FLASK_DEBUG=true

# Neon Postgres connection string, copied from the Neon dashboard.
# Both "postgres://" and "postgresql://" forms are accepted; config.py rewrites
# them to the psycopg 3 driver and adds sslmode=require if it is missing.
# Leave this unset to fall back to the local SQLite file (demo use only).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# Flask session signing key. Use a long random value, never the placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_string

OPENAI_API_KEY=your_openai_api_key_here
